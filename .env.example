# Copiare questo file in .env e sostituire i valori prima dell'avvio.
#
# NOTA: n8n dalla versione 1.0 non usa più l'autenticazione HTTP Basic.
# L'account di accesso si crea al primo avvio dall'interfaccia web
# (http://localhost:5678), non tramite variabili d'ambiente.

# Chiave con cui n8n cifra le credenziali salvate (chiavi API delle fonti CTI).
# Generarla con:  python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANTE: non modificarla dopo il primo avvio, le credenziali salvate
# diventerebbero illeggibili.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value

# Password dell'utente "neo4j" del grafo di conoscenza.
# Neo4j non si avvia con l'autenticazione di default: questa variabile è
# obbligatoria e deve contenere almeno 8 caratteri. Deve restare stabile: se
# cambia dopo il primo avvio, il container va ricreato da zero per allinearla.
NEO4J_PASSWORD=replace-with-a-long-random-value

# Questa variabile facoltativa è letta da Python. Docker non passa il file
# `.env` agli script eseguiti dalla sessione PowerShell.

# Il modello linguistico servito da Ollama, se diverso da quello predefinito
# (qwen3:8b).
# MODELLO_LLM=qwen3:8b

# Queste due variabili sono lette dal servizio Ollama al suo avvio. Vanno
# impostate come variabili utente di Windows e richiedono il riavvio di Ollama;
# copiarle nel file `.env` non basta. La cache q8_0 permette al modello di
# restare negli 8 GB di memoria video del Victus.
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
